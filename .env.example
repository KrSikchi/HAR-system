# HAR system Docker deployment settings.
#
# Copy to `.env` (gitignored) and adjust, or export these variables before
# running `docker compose up`.

# Host port to expose the HAR console / MJPEG stream on.
HAR_HOST_PORT=8080

# Port the container process listens on (same value is used for the health
# check).  Leave at 8080 unless you need a different container port.
HAR_STREAM_PORT=8080

# Input source.
#   - a file shipped in the image: demo/correct.mp4, demo/wrong_order.mp4,
#     demo/skip.mp4, tests/fixtures/synthetic_correct.mp4
#   - a path to a video mounted into the container
#   - 0 to use a live camera (also see the `devices` section in
#     docker-compose.yml)
HAR_SOURCE=demo/correct.mp4

# Protocol and colour configuration (paths are inside the image).
HAR_PROTOCOL=protocols/pts01.yaml
HAR_COLOURS=config/colours.yaml

# Stop after N frames (0 = no limit).
HAR_MAX_FRAMES=0

# 1 = keep processing (loop the file source) forever; 0 = exit at end of
# source (compose restarts the container unless you stop it).
HAR_LOOP=1

# 1 = write an MP4 recording into the out-dir (/work/runs).
HAR_RECORD=0

# 1 = explicit headless mode (the browser GUI still runs over HTTP).
HAR_HEADLESS=0

# 1 = enable offline TTS (espeak-ng is installed; most headless servers have
# no audio device, so keep 0 unless you need the spoken alerts).
HAR_VOICE=0

# Perception options - the same values accepted by `python -m har.app --help`.
HAR_DETECTOR=color
HAR_WRISTS=auto

# Additional CLI flags passed straight through to `python -m har.app`.
# Shell-split on whitespace; leave empty when not needed.
# Example: HAR_EXTRA_ARGS=--imgsz 640 --conf 0.5
HAR_EXTRA_ARGS=
